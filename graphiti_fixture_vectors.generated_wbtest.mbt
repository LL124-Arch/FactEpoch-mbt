///|
test "generated Graphiti fixture preserve-provenance" {
  let report = deduplicate_candidates([
    generated_graphiti_candidate(
      "first",
      "group-a",
      "a",
      "first predicate",
      EntityRef(EntityId::new("b")),
      " SAME\tFACT ",
      2000,
      [EpisodeId::new("episode-b")],
    ),
    generated_graphiti_candidate(
      "duplicate",
      "group-a",
      "a",
      "different predicate",
      EntityRef(EntityId::new("b")),
      "same fact",
      9000,
      [EpisodeId::new("episode-a"), EpisodeId::new("episode-b")],
    ),
  ])
  let outputs = report.candidates()
  inspect(outputs.length(), content="1")
  inspect(
    outputs[0].retained_candidate().candidate_id().value(),
    content="first",
  )
  inspect(
    outputs[0].member_candidate_ids().map(id => id.value()).join(","),
    content="first,duplicate",
  )
  inspect(
    outputs[0].episode_ids().map(id => id.value()).join(","),
    content="episode-a,episode-b",
  )
  let kinds_0 = outputs[0].parity_kinds()
  inspect(kinds_0.length(), content="2")
  inspect(kinds_0[0] == ExactUpstream, content="true")
  inspect(kinds_0[1] == DocumentedAdaptation, content="true")
}

