      [EpisodeId::new("episode-b")],
    ),
    generated_graphiti_candidate(
      "reverse",
      "group-a",
      "b",
      "first predicate",
      EntityRef(EntityId::new("a")),
      "same fact",
      2000,
      [EpisodeId::new("episode-a")],
    ),
  ])
  inspect(
    report
    .candidates()
    .map(value => value.retained_candidate().candidate_id().value())
    .join(","),
    content="first,reverse",
