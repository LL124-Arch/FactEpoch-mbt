              {"source": "alpha", "zero_based_rank": 1, "contribution": 0.5}
            ]
          },
          {
            "fact_id": "gamma-1",
            "score": 0.5,
            "contributions": [
              {"source": "gamma", "zero_based_rank": 1, "contribution": 0.5}
            ]
          },
          {
            "fact_id": "gamma-2",
            "score": 0.3333333333333333,
            "contributions": [
              {"source": "gamma", "zero_based_rank": 2, "contribution": 0.3333333333333333}
            ]
          },
          {
            "fact_id": "gamma-3",
            "score": 0.25,
            "contributions": [
              {"source": "gamma", "zero_based_rank": 3, "contribution": 0.25}
            ]
          },
          {
            "fact_id": "gamma-4",
            "score": 0.2,
            "contributions": [
              {"source": "gamma", "zero_based_rank": 4, "contribution": 0.2}
            ]
          }
        ]
      }
    },
    {
      "name": "reject-ambiguous-ranking",
      "reason": "FactEpoch rejects malformed rankings rather than letting duplicate or missing positions alter fusion.",
      "operation": "rank_validation",
      "input": {
        "checks": [
          {"kind": "blank_source", "expected_error": "InvalidRankSource"},
          {"kind": "duplicate_fact_id", "expected_error": "DuplicateRankedCandidate"},
          {"kind": "duplicate_rank", "expected_error": "DuplicateCandidateRank"},
          {"kind": "rank_gap", "expected_error": "InvalidCandidateRank"},
          {"kind": "duplicate_source", "expected_error": "DuplicateRankSource"}
        ]
      },
      "expected": {"all_rejected": true}
    },
    {
      "name": "reject-nonfinite-values",
      "reason": "FactEpoch rejects non-finite vector inputs, source scores, thresholds, and finite-input overflow before sorting.",
      "operation": "finite_validation",
      "input": {
        "checks": [
          {"kind": "left_nan", "expected_error": "NonFiniteVectorValue"},
          {"kind": "source_score_infinity", "expected_error": "NonFiniteRankedScore"},
          {"kind": "minimum_score_nan", "expected_error": "InvalidMinimumScore"},
          {"kind": "cosine_overflow", "expected_error": "NonFiniteVectorComputation"}
        ]
      },
      "expected": {"all_rejected": true}
