      "expected": {
        "fused": [
          {
            "fact_id": "a",
            "score": 1.6666666666666667,
            "contributions": [
              {"source": "alpha", "zero_based_rank": 0, "contribution": 1.0},
              {"source": "betaa", "zero_based_rank": 1, "contribution": 0.5},
              {"source": "gamma", "zero_based_rank": 5, "contribution": 0.16666666666666666}
            ]
          },
          {
            "fact_id": "beta-00",
