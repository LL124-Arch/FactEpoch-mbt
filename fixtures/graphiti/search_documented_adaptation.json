  "cases": [
    {
      "name": "fact-id-tie-break",
      "reason": "Graphiti preserves first-seen order for equal scores; FactEpoch orders equal scores by FactId.",
      "operation": "rrf",
      "input": {
        "rank_constant": 1,
        "minimum_score": 0.0,
        "lists": [
          {
            "source": "right",
            "candidates": [
              {"fact_id": "b", "zero_based_rank": 0, "source_score": null},
              {"fact_id": "a", "zero_based_rank": 1, "source_score": null}
            ]
          },
          {
            "source": "left",
            "candidates": [
              {"fact_id": "b", "zero_based_rank": 1, "source_score": null},
              {"fact_id": "a", "zero_based_rank": 0, "source_score": null}
            ]
          }
        ]
      },
      "expected": {
        "fused": [
          {
            "fact_id": "a",
            "score": 1.5,
            "contributions": [
              {"source": "left", "zero_based_rank": 0, "contribution": 1.0},
              {"source": "right", "zero_based_rank": 1, "contribution": 0.5}
            ]
          },
          {
            "fact_id": "b",
            "score": 1.5,
            "contributions": [
              {"source": "left", "zero_based_rank": 1, "contribution": 0.5},
              {"source": "right", "zero_based_rank": 0, "contribution": 1.0}
            ]
          }
        ]
      }
    },
    {
      "name": "canonical-source-permutation",
      "reason": "FactEpoch sorts unique source names and ranks before IEEE-754 accumulation so source and candidate permutations are bit-stable.",
