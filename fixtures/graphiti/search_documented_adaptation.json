          ],
          [
            {
              "source": "betaa",
              "candidates": [
                {"fact_id": "beta-00", "zero_based_rank": 0, "source_score": null},
                {"fact_id": "a", "zero_based_rank": 1, "source_score": null}
              ]
            },
            {
              "source": "gamma",
              "candidates": [
                {"fact_id": "gamma-0", "zero_based_rank": 0, "source_score": null},
                {"fact_id": "gamma-1", "zero_based_rank": 1, "source_score": null},
                {"fact_id": "gamma-2", "zero_based_rank": 2, "source_score": null},
                {"fact_id": "gamma-3", "zero_based_rank": 3, "source_score": null},
                {"fact_id": "gamma-4", "zero_based_rank": 4, "source_score": null},
                {"fact_id": "a", "zero_based_rank": 5, "source_score": null}
